# ===== Empire HR (Next.js only) =====
# Local: copy to .env.local.  Vercel: Project Settings > Environment Variables.
# Variables WITHOUT the NEXT_PUBLIC_ prefix never reach the browser.

# --- Supabase (Settings > API) ---
# The publishable key is designed to be public. Access is enforced by
# Postgres RLS, never by hiding this key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# --- Database (server only) ---
# Pages and Server Actions connect as hr_api_login; background jobs as
# hr_worker_login. Neither is the table owner. NEVER use the postgres user here.
# On Vercel use Supabase's TRANSACTION pooler (port 6543) and keep the flag true.
DATABASE_URL=postgresql://hr_api_login.your-project-ref:CHANGE_ME@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
WORKER_DATABASE_URL=postgresql://hr_worker_login.your-project-ref:CHANGE_ME@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DB_USES_TRANSACTION_POOLER=true
DB_POOL_MAX=3

# --- Background jobs (server only) ---
# Used ONLY by import/alert jobs to read uploaded files. Bypasses storage RLS.
SUPABASE_SERVICE_ROLE_KEY=
# Vercel Cron sends this as "Authorization: Bearer <secret>". Generate: openssl rand -hex 32
CRON_SECRET=

# --- Storage ---
STORAGE_BACKEND=supabase          # 'local' only for development; refused in production
LOCAL_STORAGE_DIR=./.storage
SIGNED_URL_TTL_SECONDS=60
MAX_UPLOAD_BYTES=20971520

# --- Security ---
REQUIRE_MFA_FOR_STAFF=true        # forced true in production

# --- Migrations only (your machine / CI, NEVER on Vercel) ---
# Owner connection, DIRECT (port 5432). Used by `npm run db:migrate`.
MIGRATION_DATABASE_URL=postgresql://postgres:CHANGE_ME@db.your-project-ref.supabase.co:5432/postgres
