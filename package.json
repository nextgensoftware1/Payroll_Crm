{
  "name": "empire-hr-frontend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --test --test-concurrency=1 tests/*.test.ts",
    "db:migrate": "node scripts/migrate.ts",
    "db:export": "node scripts/export-supabase-sql.ts",
    "test:pooler": "TEST_POOLER_MODE=true npm test",
    "test:sql": "psql -v ON_ERROR_STOP=1 -f db/tests/test_schema_security.sql"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/public-sans": "5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "cfb": "1.2.2",
    "clsx": "2.1.1",
    "lucide-react": "1.50.0",
    "next": "16.3.8",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-is": "19.3.0",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "25.9.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.18"
  }
